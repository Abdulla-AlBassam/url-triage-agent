# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored, `.env.example` is not.

# Required. The AI brain of the project.
# Get yours: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for the urlhaus_lookup tool. Free, 30 seconds to register.
# Get yours: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Optional but recommended. Free tier.
# Get yours: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Optional but recommended. Free tier.
# Get yours: https://urlscan.io/user/signup
URLSCAN_API_KEY=

# Which Claude model to use. Default is Sonnet, the all-rounder.
# Set to `claude-opus-4-7` if you want the heavier model for tough URLs.
MODEL=claude-sonnet-4-6
